{#
/**
 * @file
 * Themes the decreto context menu.
 *
 * Available variables:
 * - attributes: The HTML attributes for the containing element.
 * - link: A link to the file.
 * - icon: An icon.
 * - icon_only: Flag to display only the icon and not the label.
 * - icon_position: Where an icon should be displayed.
 *
 */
#}
{{ attach_library('decreto_context_menu/decreto-stretchy-navigation') }}

{#TODO: find a way to avoid using _context['']#}
{%
  set links = _context['']['#links']
%}

{% if links %}
  <div class="nav-container">
    <nav class="cd-stretchy-nav edit-content">
      <a class="cd-nav-trigger" href="#0">
        Menu
        <span aria-hidden="true"></span>
      </a>
      <ul>
        {% for link in links %}
          <li><a href="{{ link.path }}" class="{{ link.cssClass }}"><span>{{ link.name }}</span></a></li>
        {% endfor %}
      </ul>

      <span aria-hidden="true" class="stretchy-nav-bg"></span>
    </nav>
  </div>
{% endif %}