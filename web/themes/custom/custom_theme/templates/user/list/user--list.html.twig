<a href="{{ url }}"
   class="element-wrapper-link entity-list entity-list--user" data-quick-search-title="{{ user.label }}">

  <!-- Begin - icon -->
  <div class="entity-list__icon">
      <span class="initial-icon" data-toggle="tooltip" title="{{ user.label }}">
        {{ user_initials }}
      </span>
  </div>

  <!-- End - icon -->

  <!-- Begin - content -->
  <div class="entity-list__content">

    <div class="entity-list__heading">
      <h2
        class="entity-list__heading__title heading-h4">
        {% if role %}
          <i class="role-icon role-{{ role.name_safe|lower }} material-icons">star</i>
        {% endif %}
        {{ user.label }}
      </h2>
    </div>

  </div>
  <!-- End - content -->

</a>
