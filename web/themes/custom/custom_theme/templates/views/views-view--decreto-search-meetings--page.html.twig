{%
  set classes = [
  'boxy',
  'view',
  'view-' ~ id|clean_class,
  'view-id-' ~ id,
  'view-display-id-' ~ display_id,
  dom_id ? 'js-view-dom-id-' ~ dom_id,
]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if title %}
    <div class="boxy__heading">
      <h1 class="boxy__heading__title">
        {{ title }}
      </h1>
    </div>
  {% endif %}
  {{ title_suffix }}

  {% if header %}
    <div class="view-header">
      <div class="boxy__heading">
        <h1 class="boxy__heading__title">
          {{ header }}
        </h1>
      </div>
    </div>
  {% endif %}

  <!-- Begin - content -->
  <div class="boxy__body">
    <div class="div-table">

      <!-- Begin - thead -->
      <div class="div-table__thead">
        <div class="div-table__tr">
          <div class="row">
            <div class="col-xs-6"><div class="div-table__th">Name and department</div></div>
            <div class="col-xs-6"><div class="div-table__th">Date and location</div></div>
          </div>
        </div>
      </div>
      <!-- End - thead -->

      <!-- Begin - tbody -->
      {% if rows %}
        <div class="div-table__tbody">
          <div class="view-content">
            {{ rows }}
          </div>
        </div>
      {% elseif empty %}
        <div class="div-table__tbody">
          <div class="view-empty">
            {{ empty }}
          </div>
        </div>
      {% endif %}
      <!-- End - tbody -->

    </div>

    {% if pager %}
      {{ pager }}
    {% endif %}

  </div>
  <!-- End - content -->

</div>
