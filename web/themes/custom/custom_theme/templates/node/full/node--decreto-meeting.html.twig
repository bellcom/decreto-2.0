{% set classes = [
  'boxy',
  node.bundle|clean_class,
  node.isPromoted() ? 'is-promoted',
  node.isSticky() ? 'is-sticky',
  not node.isPublished() ? 'is-unpublished',
  view_mode ? view_mode|clean_class,
  'clearfix',
] %}
<article{{ attributes.addClass(classes) }}>
  <div class="boxy__heading meeting-page">

    <!-- Begin - metadata -->
    <div class="meeting-page__heading-row">
      <div class="meeting-page__info">

        <!-- Begin - title -->
        <div class="meeting-page__header">

          {% if node.field_decreto_meet_start_date.value %}
            <div class="meeting-page__datebox">
              <div class="meeting-page__datebox__day">
                {{ node.field_decreto_meet_start_date.value | date("j") }}
              </div>
              <div class="meeting-page__datebox__month">
                {{ node.field_decreto_meet_start_date.value | date("M") }}
              </div>
            </div>
          {% endif %}
          <h2 class="boxy__heading__title">
            {{ node.getTitle }}
          </h2>
        </div>
        <!-- End - title -->

        <div class="meeting-page__info-icons">
          <div class="meeting-page__info-icons__col">
            {# Begin - starting date #}
            {% if node.field_decreto_meet_start_date.value %}
              <div class="text--with-icon">
                <span class="material-icons">timer</span>
                <div>
                  {{ content.field_decreto_meet_start_date }}
                  –
                  {{ content.field_decreto_meet_end_date }}
                  {% if content['#duration'] %}
                    <span class="paletext">({{ content['#duration'] }})</span>
                  {% endif %}
                </div>
              </div>
            {% endif %}
            {# End - starting date #}

            {# Begin - location #}
            {% if node.field_decreto_meet_location.value %}
              <div class="text--with-icon">
                <i class="material-icons">place</i>
                {{ content.field_decreto_meet_location }}
              </div>
            {% endif %}
            {# End - location #}
          </div>
          <div class="meeting-page__info-icons__col">
            {# Begin - department #}
            {% if node.field_decreto_meet_department %}
              <div class="text--with-icon">
                <i class="material-icons">assignment</i>
                <a
                  href="{{ path('entity.taxonomy_term.canonical', {'taxonomy_term': node.field_decreto_meet_department.entity.id}) }}">{{ node.field_decreto_meet_department.entity.getName }}
                </a>
              </div>
            {% endif %}
            {# End - department #}

            {# Begin - participants #}
            {% if node.field_decreto_meet_location.value %}
              <div class="text--with-icon">
                <i class="material-icons">people</i>
                {% if node.field_decreto_meet_use_dep_mem.value %}
                  {{ "All department members" | trans }}
                {% else %}
                  <div>
                    {{ content.field_decreto_meet_partic_int }}
                    {{ content.field_decreto_meet_partic_ext }}
                  </div>
                {% endif %}
              </div>
            {% endif %}
            {# End - participants #}
          </div>
        </div>
        <br>
      </div>

      <div class="meeting-page__action">
        <!-- Begin - actions -->
        <div class="meeting-page__action__align">

          <div class="dropdown meeting-page__settings">
            <button class="btn btn-primary" type="button" data-toggle="dropdown">
              {{ "More actions" | trans }}
              <i class="material-icons">keyboard_arrow_down</i></button>
            <ul class="dropdown-menu">

              <!-- Begin - download full copy -->
              {% if (content.field_decreto_meet_full_doc['#items'].getValue()) %}
                <li>
                  <a
                    href="{{ file_url(node.field_decreto_meet_full_doc.entity.uri.value) }}"
                    class=" " target="_blank">
                    {{ "Download full copy" | trans }}
                  </a>
                </li>
              {% endif %}

              {% if (content.field_decreto_meet_full_doc_c['#items'].getValue()) %}
                <li>
                  <a
                    href="{{ file_url(node.field_decreto_meet_full_doc_c.entity.uri.value) }}"
                    class=" " target="_blank">
                    {{ "Download full copy (closed)" | trans }}
                  </a>
                  <!-- End - download full copy -->
                </li>
              {% endif %}

              <!-- Begin - edit -->
              {% if content['#access']['canEdit'] %}
                <li>
                  <a
                    href="{{ path('decreto_content_modify.meetings_edit', {'meeting': node.id}) }}"
                    class="use-ajax" data-dialog-type="modal">
                    {{ "Edit meeting" | trans }}
                  </a>
                  <!-- End - edit -->
                </li>

              {% endif %}


              {% if content['#access']['canConvertToReferat'] %}
                <li>
                  <a
                    href="{{ path('decreto_content_modify.meetings_update_type', {'meeting': node.id, 'type': 'referat'}) }}">
                    {{ "Convert to minutes" | trans }}
                  </a>
                  <!-- End - edit -->
                </li>
              {% endif %}

              <!-- Begin - delete -->
              {% if content['#access']['canDelete'] %}
                <li>
                  <a
                    href="{{ path('entity.node.delete_form', {'node': node.id}) }}"
                    class="use-ajax" data-dialog-type="modal">
                    {{ "Delete meeting" | trans }}
                  </a>
                </li>
              {% endif %}
              <!-- End - delete -->

            </ul>
          </div>

          <!-- Begin - meeting video link -->
          {% if (content['#video_link']) %}
            <a
               href="{{ content['#video_link'] }}"
               class="btn btn-primary" target="_blank">
              <i class="material-icons">videocam</i>
              {{ "Meeting video" | trans }}
            </a>
          {% endif %}
          <!-- End - meeting video link -->

          <!-- Begin - own notes -->
          <a
            href="{{ path('view.decreto_notes.decreto_meeting_note_page', {'meeting': node.id}) }}"
            class="btn btn-secondary">
            {{ "Own notes" | trans }}
          </a>
          <!-- End - own notes -->

        </div>
        <!-- End - actions -->

        {{ decreto_context_menu }}
      </div>
    </div>
    <!-- End - metadata -->

  </div>
  <div class="boxy__body meeting-page">

    <!-- Begin - information -->
    <div>
      <h4><strong>{{ content.field_decreto_meet_type }}</strong></h4>

      {{ content.body }}
      {#      {{ decreto_help_message.meeting_agenda }}#}
    </div>
    <!-- End - information -->

    <!-- Begin - buttons -->
    <div class="meeting-page__action-buttons">
      <div class="meeting-page__action-buttons--left">
        <div class="action-list">

          <div class="dropdown action-list__item meeting-page__buttons-wrapper">
            <button class="btn btn-primary meeting-page__drop-button" type="button" data-toggle="dropdown">
              {{ "More settings" | trans }}
              <i class="material-icons">keyboard_arrow_down</i></button>
            <ul class="dropdown-menu">

              {% if content['#access']['decreto_bullet_point']['canCreate'] %}
                {% if content['#access']['decreto_bullet_point_attachment']['canCreate'] %}
                  <!-- Begin - create from files -->
                  <li>
                    <a
                      href="{{ path('decreto_content_modify.bps_add_from_files', {'meeting': node.id()}) }}"
                      class="btn btn-primary use-ajax" data-dialog-type="modal">
                      {{ "Create point from files" | trans }}
                    </a>
                  </li>
                  <!-- End - create from files -->
                {% endif %}

                <!-- Begin - create manually -->
                <li>
                  <a
                    href="{{ path('decreto_content_modify.bps_add', {'meeting': node.id()}) }}"
                    class="btn btn-primary use-ajax" data-dialog-type="modal">
                    {{ "Create point" | trans }}
                  </a>
                </li>
                <!-- End - create manually -->
              {% endif %}

              {% if content['#access']['canEdit'] %}
                <!-- Begin - turn on/off switch mode -->
                <li>
                  <button class="btn btn-default"
                          id="meeting-agenda-switch-mode-toggle">
                    {{ "Sort bullet points" | trans }}
                  </button>
                </li>
                <!-- End - turn on/off switch mode -->
              {% endif %}

              <!-- Begin - open/close all -->
              <li>
                <button
                  class="btn btn-default js-bulletpoint-toggle-all">
                  {{ "Open/close all points" | trans }}
                </button>
              </li>
              <!-- End - open/close all -->

            </ul>
          </div>

          <!-- Begin - search button -->
          <div class="action-list__item">
            <div class="meeting__search-form">
              <button class="btn btn-secondary js-toggle-search-form">
                <i class="material-icons">search</i>
                {{ 'Filter bulletpoints' | trans }}
              </button>
            </div>
          </div>
          <!-- End - search button -->

        </div>
      </div>
    </div>
    <!-- End - buttons -->

    <!-- Begin - search form -->
    <div class="meeting__search-form-wrapper">
      {{ search_in_meeting_form }}
    </div>
    <!-- End - search form -->

    <div id="agenda-overview" class="meeting-page--agenda--wrapper">
      <br>
      {% if not node.field_decreto_meet_bps.value %}
        {% if content['#access']['decreto_bullet_point']['canCreate'] %}
          <div>
            {{ 'No bullet points added. Would you like to <a href=":url" title="Add bullet point" class="use-ajax"
            data-dialog-type="modal">create one</a>?' | trans({ ':url': path('decreto_content_modify.bps_add', {'meeting': node.id()}) }) }}
          </div>
        {% endif %}
      {% else %}
        <span class="meeting-page--agenda--line"></span>
        {{ content.field_decreto_meet_bps }}
      {% endif %}
    </div>

    {% if content['#access']['canEdit'] %}
      <div id="agenda-item-reorder" class="hidden">
        <br>
        <div class="region region-action-box__primary">
          {{ items_reorder_form }}
        </div>
      </div>
    {% endif %}

  </div>
</article>
