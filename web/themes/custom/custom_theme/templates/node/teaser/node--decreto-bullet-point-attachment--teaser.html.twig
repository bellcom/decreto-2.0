<div class="bulletpoint bulletpoint--attachment">

  <!-- Begin - bar -->
  <div class="bulletpoint__bar">

    <!-- Begin - toggler -->
    <button
      class="bulletpoint__toggler js-bulletpoint-toggle-bulletpoint"></button>
    <!-- End - toggler -->

    <!-- Begin - meta -->
    <div class="bulletpoint__meta">
      {{ label }}

      <!-- Begin - icon list -->
      <div class="bulletpoint__icon-list">

        {# Begin - notes #}
        {% if content['#contains_notes'] %}
          <button class="bulletpoint__info-button">
          <span class="material-icons"
                title="{{ 'This meeting has notes' | trans }}"
                data-toggle="tooltip">chat</span>
          </button>
        {% endif %}
        {# End - notes #}

      </div>
      <!-- End - icon list -->

    </div>
    <!-- End - meta -->

    <!-- Begin - actions -->
    <div class="bulletpoint__icon-list">

      <!-- Begin - delete -->
      {% if user.hasPermission('delete any decreto_bullet_point_attachment content') %}
        <a
          href="{{ path('decreto_content_modify.bpas_delete', {'node': node.id()}) }}"
          title="{{ "Delete bullet point attachment" | trans }}"
          data-toggle="tooltip"
          class="use-ajax" data-dialog-type="modal">
          <span class="material-icons">remove_circle</span>
        </a>
      {% endif %}
      <!-- End - delete -->

      <!-- Begin - edit -->
      {% if user.hasPermission('edit any decreto_bullet_point_attachment content') %}
        <a
          href="{{ path('decreto_content_modify.bpas_edit', {'bullet_point_attachment': node.id()}) }}"
          title="{{ "Edit bullet point attachment" | trans }}" class="use-ajax"
          data-toggle="tooltip"
          data-dialog-type="modal">
          <span class="material-icons">edit</span>
        </a>
      {% endif %}
      <!-- End - edit -->

    </div>
    <!-- End - actions -->

  </div>
  <!-- End - bar -->

  <!-- Begin - content -->
  <div class="bulletpoint__content">

    {% if node.field_decreto_bpa_html.entity.uri.value %}
      <a
        href="{{ path('decreto_content_modify.bpas_modal', {'bullet_point_attachment': node.id()}) }}"
        title="{{ "Open in popup" | trans }}" class="btn btn-secondary use-ajax"
        data-dialog-type="modal">Open in popup</a>
    {% elseif node.field_decreto_bpa_file.entity.uri.value %}
      {{ 'Download file:' | trans }} {{ content.field_decreto_bpa_file }}
    {% else %}
      <div>
        {{ content }}
      </div>
    {% endif %}

  </div>
  <!-- End - content -->

</div>
