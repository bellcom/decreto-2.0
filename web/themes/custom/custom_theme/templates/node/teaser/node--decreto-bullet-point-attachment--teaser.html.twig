<div class="bulletpoint bulletpoint--attachment">

  <!-- Begin - bar -->
  <div class="bulletpoint__bar">

  </div>
  <!-- End - bar -->



  <a class="btn-expand-collapse pull-left collapsed" role="button" data-toggle="collapse"
     href="#bpa-content-{{ node.id }}" aria-expanded="false" aria-controls="bpa-content-{{ node.id }}">
    <span class="glyphicon" aria-hidden="true"></span>
  </a>

  <div>
    <div>
      {{ title_prefix }}
      <span{{ title_attributes }}>
        {{ label }}

        {# Begin - notes #}
        {% if content['#contains_notes'] %}
          <span class="material-icons" title="{{ 'This meeting has notes' | trans }}" data-toggle="tooltip">chat</span>
        {% endif %}
        {# End - notes #}

        {# Begin - action #}
        <span class="boxy__bpa_actions boxy__actions boxy pull-right">
          <a href="{{ path('decreto_content_modify.bpas_delete', {'node': node.id()}) }}" title="{{ "Delete bullet point attachment" | trans }}" class="use-ajax" data-dialog-type="modal">-</a>
          <a href="{{ path('decreto_content_modify.bpas_edit', {'bullet_point_attachment': node.id()}) }}" title="{{ "Edit bullet point attachment" | trans }}" class="use-ajax" data-dialog-type="modal">edit</a>
        </span>
        {# End - action #}

      </span>

      {{ title_suffix }}
    </div>
  </div>

  <div{{ content_attributes.addClass('content','collapse', 'area-expand-collapse').setAttribute('id', 'bpa-content-' ~ node.id) }}>
    {% if node.field_decreto_bpa_html.entity.uri.value %}
      <a href="{{ path('decreto_content_modify.bpas_modal', {'bullet_point_attachment': node.id()}) }}" title="{{ "Open in popup" | trans }}" class="use-ajax" data-dialog-type="modal">Open in popup</a>
    {% elseif node.field_decreto_bpa_file.entity.uri.value %}
      Download file: {{ content.field_decreto_bpa_file }}
    {% else %}
      <div class="annotate-content">
        {{ content }}
      </div>
    {% endif %}
  </div>

</div>
