<div class="boxy__actions">
  {% if create_department and user.hasPermission('create terms in decreto_tax_department') %}
    {% if create_department_use_ajax %}
      <a href="{{ path('decreto_department.departments_add') }}" class="btn btn-primary use-ajax"  data-dialog-type="modal">
        {{ "Create department"|trans }}
      </a>
    {% else %}
      <a href="{{ path('decreto_department.departments_add') }}" class="btn btn-primary">
        {{ "Create department"|trans }}
      </a>
    {% endif %}
  {% endif %}
  {% if edit_department and department_id and access['decreto_department']['canEdit'] %}
    <a href="{{ path('decreto_department.departments_edit', {'department' : department_id}) }}" class="btn btn-primary use-ajax"  data-dialog-type="modal">
      {{ "Attach members"|trans }}
    </a>
  {% endif %}
  {% if department_user_create and department_id and access['decreto_department']['canEdit'] %}
    <a href="{{ path('decreto_department.users_add', {'department' : department_id}) }}" class="btn btn-primary use-ajax"  data-dialog-type="modal">
      {{ "Create user"|trans }}
    </a>
  {% endif %}
</div>
