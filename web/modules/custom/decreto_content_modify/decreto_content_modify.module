<?php

use Drupal\decreto_content_modify\Form\SearchInMeetingForm;
use Drupal\decreto_content_modify\Utils\DecretoContentModifyUtils as DecretoContentUtils;
use Drupal\decreto_content_modify\Services\ContentService;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Entity\EntityInterface;

/**
 * Implements hook_preprocess_node().
 */
function decreto_content_modify_preprocess_node(&$variables) {
  $node = $variables['node'];
  $view_mode = $variables['elements']['#view_mode'];

  // Adding search in meeting form.
  if ($node->getType() == 'decreto_meeting') {
    if ($view_mode == 'full') {
      $variables['search_in_meeting_form'] = \Drupal::formBuilder()->getForm(SearchInMeetingForm::class, $node);
    }
  }

  // Adding node id as data element.
  if ($node->getType() == 'decreto_bullet_point' || $node->getType() == 'decreto_bullet_point_attachment') {
    if ($view_mode == 'teaser') {
      $variables['attributes']['data-decreto-node-id'] = $node->id();
    }
  }
}

/*
 * Implements hook_search_api_solr_documents_alter().
 *
 * Adds meeting_nid field to bp and bpa nodes.
 */
function decreto_content_modify_search_api_solr_documents_alter(array &$documents, \Drupal\search_api\IndexInterface $index, array $items) {
  if ($index->id() == 'decreto_meeting_contents_index') {
    foreach ($documents as $document) {
      $item_id = $document->getFields()['ss_search_api_id'];
      $item = $items[$item_id];
      $originalEntity = $item->getOriginalObject()->getEntity();
      $meeting_nid = DecretoContentUtils::getRelatedNodes($originalEntity, 'decreto_meeting', FALSE);
      $document->setField('itm_meeting_nid', $meeting_nid);
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 *
 * Invalidates caches related with the decreto_memo and decreto_meeting.
 */
function decreto_content_modify_node_presave(EntityInterface $entity) {
  if ($entity->bundle() == 'decreto_memo') {
    // Invalidating memos count.
    Cache::invalidateTags([ContentService::CACHE_ID_DECRETO_MEMO_COUNTERS . ':' . $entity->getOwnerId()]);

    // Getting related meeting.
    $meeting = DecretoContentUtils::getRelatedNodes($entity, 'decreto_meeting');

    // Invalidating meeting.
    if ($meeting) {
      Cache::invalidateTags($meeting->getCacheTagsToInvalidate());
    }

  }
  elseif ($entity->bundle() == 'decreto_meeting') {
    // Invalidating meetings count.
    Cache::invalidateTags([ContentService::CACHE_ID_DECRETO_MEETING_COUNTERS]);
  }
}

/**
 * Implements hook_ENTITY_TYPE_delete().
 *
 * Invalidates caches related with the decreto_memo and decreto_meeting.
 */
function decreto_content_modify_node_delete(EntityInterface $entity) {
  if ($entity->bundle() == 'decreto_memo') {
    // Invalidating memos count.
    Cache::invalidateTags([ContentService::CACHE_ID_DECRETO_MEMO_COUNTERS . ':' . $entity->getOwnerId()]);

    // Getting related meeting.
    $meeting = DecretoContentUtils::getRelatedNodes($entity, 'decreto_meeting');

    // Invalidating meeting.
    if ($meeting) {
      Cache::invalidateTags($meeting->getCacheTagsToInvalidate());
    }
  }
  elseif ($entity->bundle() == 'decreto_meeting') {
    // Invalidating meetings count.
    Cache::invalidateTags([ContentService::CACHE_ID_DECRETO_MEETING_COUNTERS]);

    //TODO: delete meeting related content as well (bp, bpa, memo)
  }
}

/**
 * Implements hook_decreto_help_messages().
 */
function decreto_content_modify_decreto_help_messages() {
  return [
    'meetings_create_edit_form' => 'Meeting create/edit form',
    'meetings_search_in_meeting_form' => 'Search in meeting form',
  ];
}

