/**
 * Implements hook_user_login().
 *
 * Redirect to front page right after login.
 */
function decreto_content_modify_user_login(UserInterface $account) {
  $url = Url::fromRoute('<front>');

  // If user has no organisation selected, select the first one.
  $organisation_id = \Drupal::service('decreto_organisation.organisation')->getSelectedOrganisation(FALSE);
  if (!$organisation_id) {
    $user = User ::load($account->id());
    $decretoUser = new DecretoUser($user);
    $orgIds = $decretoUser->getOrganisations(FALSE);
    $organisation_id = reset($orgIds);
    if ($organisation_id) {
      \Drupal::service('decreto_organisation.organisation')->setSelectedOrganisation($organisation_id);
    }
    else {
      // TODO: make sure message is present.
      $messenger = \Drupal::messenger();
      $messenger
        ->addMessage('This user has no organisation attached. Please contact the application administatator', MessengerInterface::TYPE_WARNING, TRUE);
      $url = Url::fromRoute('user.logout');
    }

  }

  $response = new RedirectResponse($url->toString());
  $response->send();
}

/**
 * Implements hook_preprocess_node().
 */
function decreto_content_modify_preprocess_node(&$variables) {
  $node = $variables['node'];
  $view_mode = $variables['elements']['#view_mode'];

  if ($node->getType() == 'decreto_meeting') {
    if ($view_mode == 'full') {
      // Adding search in meeting form.
      $variables['search_in_meeting_form'] = \Drupal::formBuilder()->getForm(SearchInMeetingForm::class, $node);
      // Adding items reorder form.
      $variables['items_reorder_form'] = \Drupal::formBuilder()->getForm(MeetingItemsReorderForm::class, $node);
    }
  }
}

/*
 * Implements hook_search_api_solr_documents_alter().
 *
 * Adds meeting_nid field to bp and bpa nodes.
 */
function decreto_content_modify_search_api_solr_documents_alter(array &$documents, \Drupal\search_api\IndexInterface $index, array $items) {
  if ($index->id() == 'decreto_meeting_contents_index') {
    foreach ($documents as $document) {
      $item_id = $document->getFields()['ss_search_api_id'];
      $item = $items[$item_id];
      $originalEntity = $item->getOriginalObject()->getEntity();

      $meeting_nid = 0;

      if ($originalEntity->getType() == 'decreto_bullet_point') {
        $decretoBP = new DecretoBulletPoint($originalEntity);
        $meeting_nid = $decretoBP->getMeeting(FALSE);
      }
      elseif ($originalEntity->getType() == 'decreto_bullet_point_attachment') {
        $decretoBPA = new DecretoBulletPointAttachment($originalEntity);
        $meeting_nid = $decretoBPA->getMeeting(FALSE);
      }

      $document->setField('itm_meeting_nid', $meeting_nid);
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert().
 *
 * Invalidates caches related with the decreto_memo and decreto_meeting.
 */
function decreto_content_modify_node_insert(EntityInterface $entity) {
  if ($entity->bundle() == 'decreto_memo') {
    // Invalidating memos count.
    Cache::invalidateTags([ContentService::CACHE_ID_DECRETO_MEMO_COUNTERS . ':' . $entity->getOwnerId()]);

    // Getting related meeting.
    $decretoMemo = new DecretoMemo($entity);
    $meeting = $decretoMemo->getMeeting();

    // Invalidating meeting.
    if ($meeting) {
      Cache::invalidateTags($meeting->getCacheTagsToInvalidate());
    }
  }
  elseif ($entity->bundle() == 'decreto_meeting') {
    // Invalidating meetings count.
    Cache::invalidateTags([ContentService::CACHE_ID_DECRETO_MEETING_COUNTERS]);
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 *
 * Decreto_bullet_point_attachment: Handles removing/attaching of BPA file to
 * the related meeting node.
 */
function decreto_content_modify_node_presave(EntityInterface $entity) {
  if ($entity->bundle() == 'decreto_memo') {
  }
  elseif ($entity->bundle() == 'decreto_meeting') {
  }
  elseif ($entity->bundle() == 'decreto_bullet_point') {
  }
  elseif ($entity->bundle() == 'decreto_bullet_point_attachment') {
    // Duplicating file reference to the related meeting as well.
    $decretoBPA = new DecretoBulletPointAttachment($entity);

    $old_related_fid = NULL;
    if ($entity->original) {
      $originalDecretoBPA = new DecretoBulletPointAttachment($entity->original);
      $old_related_fid = $originalDecretoBPA->getFile(FALSE);
    }
    $new_related_fid = $decretoBPA->getFile(FALSE);

    $meeting = $decretoBPA->getMeeting();
    if ($meeting) {
      $decretoMeeting = new DecretoMeeting($meeting);

      // Remove file from meeting.
      if ($old_related_fid && $old_related_fid != $new_related_fid) {
        $decretoMeeting->removeBpaFile($old_related_fid);
      }

      // Add file to meeting, if it's not present there yet.
      if ($new_related_fid) {
        $decretoMeeting->addBpaFile($new_related_fid);
      }
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_predelete().
 */
function decreto_content_modify_node_predelete(EntityInterface $entity) {
  if ($entity->bundle() == 'decreto_meeting') {
    // Getting related BPs.
    $decretoMeeting = new DecretoMeeting($entity);
    $bps = $decretoMeeting->getBulletPoints();

    // Removing references to all BPs to avoid repetitive meeting update, see
    // decreto_content_modify_node_delete() decreto_bullet_point delete.
    // Skipping search index update about this change.
    $decretoMeeting->getEntity()->search_api_skip_tracking = TRUE;
    $decretoMeeting->setBulletPoints([]);

    // Deleting related BPs.
    if (!empty($bps)) {
      foreach ($bps as $bp) {
        $bp->delete();
      }
    }

    // Deleting related messages (deleting message will also delete related
    // notifications).
    $messages = $decretoMeeting->getMessages();
    if (!empty($messages)) {
      foreach ($messages as $message) {
        $message->delete();
      }
    }

    // Since we skipped search API tracking, we have to force the item to be
    // removed from all relevant search indices.
    decreto_content_modify_track_item_deleted($entity);
  }
  elseif ($entity->bundle() == 'decreto_bullet_point') {
    // Deleting related memos.
    $decretoBP = new DecretoBulletPoint($entity);
    $memos = $decretoBP->getMemos();
    if (!empty($memos)) {
      foreach ($memos as $memo) {
        $memo->delete();
      }
    }

    // Getting related BPAa.
    $bpas = $decretoBP->getBulletPointAttachments();

    // Removing references to all BPAa to avoid repetitive BP update, see
    // decreto_content_modify_node_delete() decreto_bullet_point_attachment
    // delete.
    // Skipping search index update about this change.
    $decretoBP->getEntity()->search_api_skip_tracking = TRUE;
    $decretoBP->setBulletPointAttachments([]);

    // Deleting related BPAa.
    if (!empty($bpas)) {
      foreach ($bpas as $bpa) {
        $bpa->delete();
      }
    }

    // Since we skipped search API tracking, we have to force the item to be
    // removed from all relevant search indices.
    decreto_content_modify_track_item_deleted($entity);
  }
  elseif ($entity->bundle() == 'decreto_bullet_point_attachment') {
    // Deleting related notes.
    $decretoBPA = new DecretoBulletPointAttachment($entity);
    $notes = $decretoBPA->getNotes();

    if (!empty($notes)) {
      foreach ($notes as $note) {
        $note->delete();
      }
    }

    // Removing BPA file from meeting.
    $fid = $decretoBPA->getFile(FALSE);
    $meeting = $decretoBPA->getMeeting();
    if ($meeting && $fid) {
      $decretoMeeting = new DecretoMeeting($meeting);
      $decretoMeeting->removeBpaFile($fid);
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_delete().
 *
 * Invalidates caches related with the decreto_memo and decreto_meeting.
 */
function decreto_content_modify_node_delete(EntityInterface $entity) {
  if ($entity->bundle() == 'decreto_memo') {
    // Invalidating memos count.
    Cache::invalidateTags([ContentService::CACHE_ID_DECRETO_MEMO_COUNTERS . ':' . $entity->getOwnerId()]);

    // Getting related meeting.
    $decretoMemo = new DecretoMemo($entity);
    $meeting = $decretoMemo->getMeeting();

    // Invalidating meeting.
    if ($meeting) {
      Cache::invalidateTags($meeting->getCacheTagsToInvalidate());
    }
  }
  elseif ($entity->bundle() == 'decreto_meeting') {
    // Invalidating meetings count.
    Cache::invalidateTags([ContentService::CACHE_ID_DECRETO_MEETING_COUNTERS]);
  }
  elseif ($entity->bundle() == 'decreto_bullet_point') {
    // Deleting this BP from meeting.
    $decretoBP = new DecretoBulletPoint($entity);
    $meeting = $decretoBP->getMeeting();
    if ($meeting) {
      $decretoMeeting = new DecretoMeeting($meeting);
      $decretoMeeting->removeBulletPoint($entity->id());
    }
  }
  elseif ($entity->bundle() == 'decreto_bullet_point_attachment') {
    // Deleting this BPA from BP.
    $decretoBPA = new DecretoBulletPointAttachment($entity);
    $bp = $decretoBPA->getBulletPoint();
    if ($bp) {
      $decretoBP = new DecretoBulletPoint($bp);
      $decretoBP->removeBulletPointAttachment($entity->id());
    }
  }
}

