  return $data;
}

/**
 * Implements hook_node_access().
 *
 * Changes access to closed nodes: closed/personal bullet points and their child
 * bullet point attachments.
 */
function decreto_content_modify_node_access(NodeInterface $node, $op, AccountInterface $account) {
  if ($op == 'view') {
    if ($node->bundle() == 'decreto_bullet_point') {
      $decretoBP = new DecretoBulletPoint($node);

      if ($decretoBP->isClosed() || $decretoBP->isPersonal()) {
        $meeting = $decretoBP->getMeeting();

        return AccessController::viewMeetingClosedContentAccess($meeting, $account);
      }
    }
    if ($node->bundle() == 'decreto_bullet_point_attachment') {
      $decretoBPA = new DecretoBulletPointAttachment($node);

      // User BP access permissions for deciding.
      $bp = $decretoBPA->getBulletPoint();
      if (!$bp->access('view')) {
        return AccessResult::forbidden('Cannot access closed content');
      }
    }
  }
  elseif ($op == 'update') {
    if ($node->bundle() == 'decreto_meeting') {
      return AccessController::editMeetingAccess($node, $account);
    }
    elseif ($node->bundle() == 'decreto_bullet_point') {
      return AccessController::editBulletPointAccess($node, $account);
    }
    elseif ($node->bundle() == 'decreto_bullet_point_attachment') {
      return AccessController::editBulletPointAttachmentAccess($node, $account);
    }
  }
  elseif ($op == 'delete') {
    if ($node->bundle() == 'decreto_meeting') {
      return AccessController::deleteMeetingAccess($node, $account);
    }
    elseif ($node->bundle() == 'decreto_bullet_point') {
      return AccessController::deleteBulletPointAccess($node, $account);
    }
    elseif ($node->bundle() == 'decreto_bullet_point_attachment') {
      return AccessController::deleteBulletPointAttachmentAccess($node, $account);
    }
  }

  return AccessResult::neutral();
}

/**
 * Implements hook_entity_field_access().
 *
 * Changes access to close type fields: field_decreto_meet_full_doc_c.
 */
function decreto_content_modify_entity_field_access($op, FieldDefinitionInterface $field_definition, AccountInterface $account, FieldItemListInterface $items = NULL) {
  if ($op == 'view') {
    $field_name = $field_definition->getName();
    if ($field_name == 'field_decreto_meet_full_doc_c') {
      $meeting = $items->getEntity();
      return AccessController::viewMeetingClosedContentAccess($meeting, $account);
    }
  }

  return AccessResult::neutral();
}

/**
 * Helper function.
 *
 * Marks a single item as deleted for all interested search indices.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   Entity to mark as deleted.
 */
function decreto_content_modify_track_item_deleted(EntityInterface $entity) {
  $indexes = ContentEntity::getIndexesForEntity($entity);
  $datasource_id = 'entity:' . $entity->getEntityTypeId();
  $combined_id = $entity->id() . ':' . $entity->language()->getId();

  foreach ($indexes as $index) {
    $index->trackItemsDeleted($datasource_id, [$combined_id]);
  }
}
