{#
/**
 * @file
 * Template for user search popup.
 */
#}
{{ help_message }}
<form>
    <div class="form-item js-form-item form-type-textfield js-form-type-textfield form-item-s js-form-item-s form-group">
        <label class="control-label">{{ 'Type name' | trans }}</label>
        <input class="form-text form-control" type="text" name="user-name" value="">
    </div>
    <div class="form-actions form-group form-wrapper">
        <input class="buttonform-submit btn-info btn" type="submit" value="{{ 'Find' | trans }}" >{{ 'Find' | trans }}</div>
    </div>
</form>
<h2>{{ 'Search results' | trans }}</h2>
<div class="users-list">
    {{ users_list }}
</div>
